# Contact form delivery (src/pages/api/contact.ts).
# Without these three the endpoint answers 503 and the form shows its error state.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Comma-separated list is supported.
CONTACT_TO_EMAIL=sales@modulargroup.com
# Must be a domain verified in Resend.
CONTACT_FROM_EMAIL=Modular Group <website@modulargroup.com>
