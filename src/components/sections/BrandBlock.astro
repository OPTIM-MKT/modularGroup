---
import { Image } from "astro:assets";
import { FiArrowRight, FiCheck, FiExternalLink } from "react-icons/fi";

import BrandMark from "@/components/shared/BrandMark.astro";
import type { Brand } from "@/config/brands";

interface Props {
  brand: Brand;
  tagline: string;
  summary: string;
  points: readonly string[];
  href: string;
  ctaLabel: string;
  /** Alternates the image side so the four blocks read as a rhythm. */
  index: number;
}

const { brand, tagline, summary, points, href, ctaLabel, index } = Astro.props;

const imageLeft = index % 2 === 1;
---

{/* `data-brand` re-points every token below it: the block is rendered by the
    same components as the rest of the page but wears the company's palette. */}
<section
  data-brand={brand.key}
  aria-labelledby={`brand-${brand.key}`}
  class="section-y bg-canvas transition-colors"
>
  <div class="container-x">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class:list={["reveal", imageLeft && "lg:order-2"]}>
        <div class="inline-flex items-center gap-2.5 rounded-full bg-accent/10 px-3.5 py-1.5 border border-accent/25">
          <span
            class="h-2 w-2 rounded-full"
            style={`background-color:${brand.swatch}`}
            aria-hidden="true"
          />
          <span class="type-eyebrow text-accent font-semibold tracking-wider">
            {tagline}
          </span>
        </div>

        <h2 id={`brand-${brand.key}`} class="mt-6">
          <span class="sr-only">{brand.name}</span>
          <BrandMark brand={brand} size={50} />
        </h2>

        <p class="type-subheading mt-6 max-w-xl text-ink/85">{summary}</p>

        <ul class="mt-7 grid gap-3">
          {
            points.map((point) => (
              <li class="flex items-start gap-3 text-[0.95rem] leading-relaxed text-muted">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent font-bold"
                  aria-hidden="true"
                >
                  <FiCheck className="h-3 w-3" strokeWidth={3} />
                </span>
                {point}
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={href} class="btn btn-primary group shadow-md hover:shadow-lg">
            {ctaLabel}
            <FiArrowRight
              className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
              aria-hidden="true"
            />
          </a>
          <a
            href={brand.website}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline group gap-2"
          >
            <span>{brand.website.replace("https://", "").replace("/", "")}</span>
            <FiExternalLink
              className="h-3.5 w-3.5 opacity-70 transition-opacity group-hover:opacity-100"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>

      <div
        class:list={["reveal relative", imageLeft && "lg:order-1"]}
        style="transition-delay:120ms"
      >
        <div class="overflow-hidden rounded-panel border border-line/60 bg-panelAlt shadow-e2 transition-transform duration-500 hover:scale-[1.01]">
          <Image
            src={brand.image}
            alt={brand.name}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 46vw, 92vw"
            loading="lazy"
            class="aspect-4/3 h-full w-full object-cover"
          />
        </div>

        {/* A brand-tinted glow anchors the frame to the company it belongs to. */}
        <div
          class:list={[
            "pointer-events-none absolute -bottom-6 -z-10 h-28 w-2/3 rounded-panel blur-3xl",
            imageLeft ? "-left-6" : "-right-6",
          ]}
          style={`background-color:${brand.swatch};opacity:0.28`}
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>
</section>
