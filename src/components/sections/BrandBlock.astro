---
import { Image } from "astro:assets";
import { FiArrowRight, FiCheck } from "react-icons/fi";

import BrandMark from "@/components/shared/BrandMark.astro";
import template from "@/assets/template.png";
import type { Brand } from "@/config/brands";

interface Props {
  brand: Brand;
  tagline: string;
  summary: string;
  points: readonly string[];
  href: string;
  ctaLabel: string;
  /** Alternates the image side so the four blocks read as a rhythm. */
  index: number;
}

const { brand, tagline, summary, points, href, ctaLabel, index } = Astro.props;

const imageLeft = index % 2 === 1;
---

{/* `data-brand` re-points every token below it: the block is rendered by the
    same components as the rest of the page but wears the company's palette. */}
<section
  data-brand={brand.key}
  aria-labelledby={`brand-${brand.key}`}
  class="section-y bg-canvas"
>
  <div class="container-x">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class:list={["reveal", imageLeft && "lg:order-2"]}>
        <p class="type-eyebrow flex items-center gap-3 text-accent">
          <span class="h-px w-8 bg-accent/45" aria-hidden="true" />
          {tagline}
        </p>

        <h2 id={`brand-${brand.key}`} class="mt-5">
          <span class="sr-only">{brand.name}</span>
          <BrandMark brand={brand} size={46} />
        </h2>

        <p class="type-subheading mt-6 max-w-xl text-ink/85">{summary}</p>

        <ul class="mt-7 grid gap-3">
          {
            points.map((point) => (
              <li class="flex items-start gap-3 text-[0.95rem] leading-relaxed text-muted">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent/12 text-accent"
                  aria-hidden="true"
                >
                  <FiCheck className="h-3 w-3" strokeWidth={3} />
                </span>
                {point}
              </li>
            ))
          }
        </ul>

        <a href={href} class="btn btn-primary group mt-9">
          {ctaLabel}
          <FiArrowRight
            className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
            aria-hidden="true"
          />
        </a>
      </div>

      <div
        class:list={["reveal relative", imageLeft && "lg:order-1"]}
        style="transition-delay:120ms"
      >
        <div class="overflow-hidden rounded-panel bg-panelAlt shadow-e2">
          <Image
            src={template}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 46vw, 92vw"
            loading="lazy"
            class="aspect-4/3 h-full w-full object-cover"
          />
        </div>

        {/* A brand-tinted glow anchors the frame to the company it belongs to. */}
        <div
          class:list={[
            "pointer-events-none absolute -bottom-6 -z-10 h-28 w-2/3 rounded-panel blur-3xl",
            imageLeft ? "-left-6" : "-right-6",
          ]}
          style={`background-color:${brand.swatch};opacity:0.22`}
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>
</section>
