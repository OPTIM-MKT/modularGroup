---
import { Image } from "astro:assets";
import { FiArrowDown, FiArrowRight } from "react-icons/fi";

import template from "@/assets/template.png";
import growthImage from "@/assets/images/home/growth.webp";
import kfImage from "@/assets/images/home/kf.webp";
import BrandBlock from "@/components/sections/BrandBlock.astro";
import ContactSection from "@/components/sections/ContactSection.astro";
import StoryBlock from "@/components/sections/StoryBlock.astro";
import BrandMark from "@/components/shared/BrandMark.astro";
import CtaSection from "@/components/shared/CtaSection.astro";
import PillarGrid from "@/components/shared/PillarGrid.astro";
import SectionHeader from "@/components/shared/SectionHeader.astro";
import StatGrid from "@/components/shared/StatGrid.astro";
import { BRANDS } from "@/config/brands";
import { getI18N, getLang } from "@/i18n/i18n";
import { localePath } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = getI18N(Astro.currentLocale);
const href = (to: string) => localePath(lang, to);
---

{/* --- Founder story ---------------------------------------------------- */}
<StoryBlock
  image={kfImage}
  imageAlt="Karlo Fuentes Founder of Modular Group"
  headingId="story-founder"
  eyebrow={t.home.founderStory.eyebrow}
  title={t.home.founderStory.title}
  body={t.home.founderStory.body}
  founderLabel={t.home.founderStory.founderLabel}
  founderName={t.home.founderStory.founderName}
  badge={t.home.founderStory.since}
  imagePosition="right"
/>

{/* --- Our growth ------------------------------------------------------- */}
<StoryBlock
  image={growthImage}
  imageAlt="Modular Group manufacturing facility"
  headingId="story-growth"
  eyebrow={t.home.ourGrowth.eyebrow}
  title={t.home.ourGrowth.title}
  body={t.home.ourGrowth.body}
  imagePosition="left"
/>

{/* --- Hero ------------------------------------------------------------- */}
<section class="relative isolate overflow-hidden bg-canvas hairline-b">
  <Image
    src={template}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover opacity-[0.14] dark:opacity-[0.07]"
  />
  <div
    class="absolute inset-0 -z-10 bg-linear-to-b from-canvas/40 via-canvas/80 to-canvas"
    aria-hidden="true"
  >
  </div>

  <div class="container-x pb-20 pt-16 lg:pb-28 lg:pt-24">
    <div class="max-w-3xl">
      <p class="reveal type-eyebrow flex items-center gap-3 text-accent">
        <span class="h-px w-8 bg-accent/45" aria-hidden="true"></span>
        {t.home.hero.eyebrow}
      </p>

      <h1
        class="reveal type-display mt-6 text-ink"
        style="transition-delay:60ms"
      >
        {t.home.hero.title}
      </h1>

      <p
        class="reveal type-subheading mt-6 max-w-2xl text-ink/85"
        style="transition-delay:120ms"
      >
        {t.home.hero.subtitle}
      </p>

      <p
        class="reveal type-body mt-5 max-w-2xl text-muted"
        style="transition-delay:180ms"
      >
        {t.home.hero.description}
      </p>

      <div
        class="reveal mt-10 flex flex-wrap items-center gap-3"
        style="transition-delay:240ms"
      >
        <a
          href={href("/contact")}
          class="btn btn-primary group px-6 py-3 shadow-md hover:shadow-lg"
        >
          {t.home.hero.primaryCta}
          <FiArrowRight
            className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
            aria-hidden="true"
          />
        </a>
        <a href="#companies" class="btn btn-outline group px-6 py-3">
          {t.home.hero.secondaryCta}
          <FiArrowDown
            className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-y-0.5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>

    {
      /* The four brand cards with logo, representative color, name and specialty */
    }
    <div
      class="reveal mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 border-t border-line/80 pt-10"
      style="transition-delay:300ms"
    >
      {
        BRANDS.map((brand) => (
          <a
            href={href(`/${brand.slug}`)}
            class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-line bg-panel/75 p-5 backdrop-blur-md transition-all duration-300 hover:-translate-y-1.5 hover:border-transparent hover:shadow-xl dark:bg-panel/60"
          >
            {/* Ambient hover glow in brand color */}
            <div
              class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style={`background: radial-gradient(circle at 50% 0%, ${brand.swatch}22 0%, transparent 75%); border: 1.5px solid ${brand.swatch}66; border-radius: inherit;`}
              aria-hidden="true"
            />

            <div>
              {/* Top right Arrow */}
              <div class="flex items-center justify-end">
                <FiArrowRight
                  className="h-4 w-4 opacity-60 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100"
                  style={{ color: brand.swatch }}
                  aria-hidden="true"
                />
              </div>

              {/* Brand Logo with authentic colors */}
              <div class="mt-1 flex h-20 items-center justify-center">
                <BrandMark brand={brand} size={64} />
              </div>

              {/* Brand Tagline */}
              <p class="mt-4 text-center text-xs leading-relaxed text-muted line-clamp-2">
                {t.brands[brand.key].tagline}
              </p>
            </div>

            {/* Bottom accent stripe */}
            <div
              class="mt-5 h-1 w-8 rounded-full transition-all duration-300 group-hover:w-full"
              style={`background-color:${brand.swatch}`}
              aria-hidden="true"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

{/* --- Group intro ------------------------------------------------------ */}
<section class="section-y bg-canvas">
  <div class="container-x">
    <SectionHeader
      eyebrow={t.home.intro.eyebrow}
      title={t.home.intro.title}
      description={t.home.intro.description}
    />
    <StatGrid stats={t.home.stats} class="mt-12" />
  </div>
</section>

{/* --- The four companies ----------------------------------------------- */}
<section id="companies" class="section-y-sm bg-canvasAlt hairline-t">
  <div class="container-x">
    <SectionHeader
      eyebrow={t.home.companies.eyebrow}
      title={t.home.companies.title}
      description={t.home.companies.description}
    />
  </div>
</section>

{
  BRANDS.map((brand, index) => (
    <BrandBlock
      brand={brand}
      index={index}
      tagline={t.brands[brand.key].tagline}
      summary={t.brands[brand.key].home.summary}
      points={t.brands[brand.key].home.points}
      href={href(`/${brand.slug}`)}
      ctaLabel={t.common.visitCompany}
    />
  ))
}

{/* --- Why the group ---------------------------------------------------- */}
<section class="section-y bg-canvasAlt hairline-t">
  <div class="container-x">
    <SectionHeader
      eyebrow={t.home.advantages.eyebrow}
      title={t.home.advantages.title}
    />
    <PillarGrid items={t.home.advantages.items} columns={4} class="mt-12" />
  </div>
</section>

<ContactSection
  eyebrow={t.home.contact.eyebrow}
  title={t.home.contact.title}
  description={t.home.contact.description}
  class="bg-canvas"
/>

<CtaSection
  eyebrow={t.home.cta.eyebrow}
  title={t.home.cta.title}
  description={t.home.cta.description}
  primaryLabel={t.home.cta.primaryLabel}
  primaryHref={href("/contact")}
  secondaryLabel={t.home.cta.secondaryLabel}
  secondaryHref="#companies"
/>
