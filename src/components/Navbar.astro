---
import { FiArrowRight, FiMenu, FiX } from "react-icons/fi";

import BrandMark from "@/components/shared/BrandMark.astro";
import GroupMark from "@/components/shared/GroupMark.astro";
import LangToggle from "@/components/shared/LangToggle.astro";
import ThemeToggle from "@/components/shared/ThemeToggle.astro";
import { BRANDS } from "@/config/brands";
import { getI18N, getLang } from "@/i18n/i18n";
import { localePath, stripLocale } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = getI18N(Astro.currentLocale);

const path = stripLocale(Astro.url.pathname);
const href = (to: string) => localePath(lang, to);
const isActive = (to: string) => path === to;
---

<a
  href="#main"
  class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-4 focus-visible:z-[60] focus-visible:rounded-full focus-visible:bg-primary focus-visible:px-4 focus-visible:py-2 focus-visible:text-sm focus-visible:font-semibold focus-visible:text-onPrimary"
>
  {t.nav.skipToContent}
</a>

<header
  data-header
  class="glass-chrome sticky top-0 z-50 border-b border-line/80 shadow-xs"
>
  <div class="container-x flex h-16 items-center justify-between gap-4 lg:h-[4.75rem]">
    {/* Left: Mobile hamburger (mobile only) & Group Mark (desktop & mobile) */}
    <div class="flex items-center gap-3">
      <button
        type="button"
        data-menu-toggle
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.nav.openMenu}
        class="icon-btn lg:hidden"
      >
        <FiMenu
          data-menu-icon
          className="h-[18px] w-[18px]"
          aria-hidden="true"
        />
        <FiX
          data-close-icon
          className="hidden h-[18px] w-[18px]"
          aria-hidden="true"
        />
      </button>

      <a
        href={href("/")}
        aria-label={t.nav.groupHome}
        aria-current={isActive("/") ? "page" : undefined}
        class="press flex items-center rounded-xl px-2 py-1.5 hover:bg-panelAlt/80 transition-colors"
      >
        <GroupMark size="md" class="lg:hidden" />
        <GroupMark size="lg" class="max-lg:hidden" />
      </a>
    </div>

    {/* Center: The 4 Brand Logos — larger, elegant, crisp */}
    <nav
      class="hidden lg:flex items-center justify-center gap-1.5 xl:gap-3"
      aria-label={t.nav.companies}
    >
      {
        BRANDS.map((brand) => (
          <a
            href={href(`/${brand.slug}`)}
            aria-current={isActive(`/${brand.slug}`) ? "page" : undefined}
            class="press group relative flex items-center gap-2.5 rounded-full px-3.5 py-2 transition-all duration-200 hover:bg-panelAlt/80 aria-[current=page]:bg-panelAlt aria-[current=page]:shadow-xs"
          >
            <span
              class="h-2 w-2 shrink-0 rounded-full opacity-75 transition-transform duration-300 group-hover:scale-125 group-hover:opacity-100 group-aria-[current=page]:opacity-100"
              style={`background-color:${brand.swatch}`}
              aria-hidden="true"
            />
            <BrandMark brand={brand} size={32} />
          </a>
        ))
      }
    </nav>

    {/* Right: Controls & Contact CTA button */}
    <div class="flex items-center gap-2 sm:gap-2.5">
      <div class="hidden sm:flex items-center gap-2">
        <LangToggle label={t.nav.language} />
        <ThemeToggle label={t.nav.theme} />
      </div>

      <div class="sm:hidden">
        <ThemeToggle label={t.nav.theme} />
      </div>

      <a
        href={href("/contact")}
        class="btn btn-primary group px-4 py-2 text-xs font-semibold"
      >
        {t.nav.contact}
        <FiArrowRight
          className="h-3.5 w-3.5 transition-transform duration-300 ease-out group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>

  {/* Mobile sheet */}
  <div
    id="mobile-nav"
    data-mobile-nav
    hidden
    class="origin-top border-t border-line bg-canvas/95 backdrop-blur-xl lg:hidden"
  >
    <div class="container-x py-6">
      <ul class="grid gap-1.5">
        <li>
          <a
            href={href("/")}
            aria-current={isActive("/") ? "page" : undefined}
            class="press flex items-center justify-between rounded-2xl px-4 py-3.5 font-semibold text-ink hover:bg-panelAlt aria-[current=page]:bg-panelAlt"
          >
            {t.nav.home}
          </a>
        </li>

        {
          BRANDS.map((brand) => (
            <li>
              <a
                href={href(`/${brand.slug}`)}
                aria-current={isActive(`/${brand.slug}`) ? "page" : undefined}
                class="press flex items-center gap-3.5 rounded-2xl px-4 py-3.5 hover:bg-panelAlt aria-[current=page]:bg-panelAlt"
              >
                <span
                  class="h-2.5 w-2.5 shrink-0 rounded-full"
                  style={`background-color:${brand.swatch}`}
                  aria-hidden="true"
                />
                <BrandMark brand={brand} size={30} />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-6 flex items-center justify-between gap-3 border-t border-line pt-5">
        <LangToggle label={t.nav.language} />
        <a href={href("/contact")} class="btn btn-primary group">
          {t.nav.contact}
          <FiArrowRight
            className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  let cleanup: (() => void) | null = null;

  function initHeader() {
    cleanup?.();

    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-mobile-nav]");

    const setOpen = (open: boolean) => {
      if (!toggle || !panel) return;
      toggle.setAttribute("aria-expanded", String(open));

      if (open) {
        panel.hidden = false;
        requestAnimationFrame(() => {
          panel.style.opacity = "1";
          panel.style.transform = "none";
        });
      } else {
        panel.style.opacity = "0";
        panel.style.transform = "translateY(-8px) scale(0.99)";
        window.setTimeout(() => {
          if (toggle.getAttribute("aria-expanded") === "false") panel.hidden = true;
        }, 220);
      }

      document.documentElement.classList.toggle("overflow-hidden", open);
      toggle.setAttribute(
        "aria-label",
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ??
          toggle.getAttribute("aria-label") ??
          "",
      );
      toggle.querySelector("[data-menu-icon]")?.classList.toggle("hidden", open);
      toggle.querySelector("[data-close-icon]")?.classList.toggle("hidden", !open);
    };

    if (panel) {
      panel.style.transition =
        "opacity 240ms cubic-bezier(0.22,1,0.36,1), transform 240ms cubic-bezier(0.22,1,0.36,1)";
      panel.style.opacity = "0";
      panel.style.transform = "translateY(-8px) scale(0.99)";
    }

    const onToggleClick = () =>
      setOpen(toggle?.getAttribute("aria-expanded") !== "true");
    toggle?.addEventListener("click", onToggleClick);

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    };
    document.addEventListener("keydown", onKeydown);

    const onNavigate = () => {
      document.documentElement.classList.remove("overflow-hidden");
      setOpen(false);
    };
    panel?.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) onNavigate();
    });

    cleanup = () => {
      document.removeEventListener("keydown", onKeydown);
      toggle?.removeEventListener("click", onToggleClick);
      document.documentElement.classList.remove("overflow-hidden");
    };
  }

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
