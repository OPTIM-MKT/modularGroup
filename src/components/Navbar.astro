---
import { FiMenu, FiX } from "react-icons/fi";

import GroupMark from "@/components/shared/GroupMark.astro";
import LangToggle from "@/components/shared/LangToggle.astro";
import ThemeToggle from "@/components/shared/ThemeToggle.astro";
import { brandsOn, BRANDS } from "@/config/brands";
import { getI18N, getLang } from "@/i18n/i18n";
import { localePath, stripLocale } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const t = getI18N(Astro.currentLocale);

const path = stripLocale(Astro.url.pathname);
const href = (to: string) => localePath(lang, to);
const isActive = (to: string) => path === to;

const left = brandsOn("left");
const right = brandsOn("right");
---

<a
  href="#main"
  class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-4 focus-visible:z-[60] focus-visible:rounded-full focus-visible:bg-primary focus-visible:px-4 focus-visible:py-2 focus-visible:text-sm focus-visible:font-semibold focus-visible:text-onPrimary"
>
  {t.nav.skipToContent}
</a>

<header
  data-header
  class="glass-chrome sticky top-0 z-50 border-b border-line/80 shadow-xs"
>
  <div class="container-x relative flex h-16 items-center justify-between lg:h-20">
    {/* Mobile Left: Hamburger Toggle */}
    <button
      type="button"
      data-menu-toggle
      data-label-open={t.nav.openMenu}
      data-label-close={t.nav.closeMenu}
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={t.nav.openMenu}
      class="icon-btn lg:hidden"
    >
      <FiMenu
        data-menu-icon
        className="h-[18px] w-[18px]"
        aria-hidden="true"
      />
      <FiX
        data-close-icon
        className="hidden h-[18px] w-[18px]"
        aria-hidden="true"
      />
    </button>

    {/* Mobile Center: Modular Group Wordmark */}
    <a
      href={href("/")}
      aria-label={t.nav.groupHome}
      aria-current={isActive("/") ? "page" : undefined}
      class="press flex items-center rounded-xl px-3 py-1.5 transition-colors lg:hidden"
    >
      <GroupMark size="md" />
    </a>

    {/* Desktop: Perfectly Symmetrical 2-Left — Center Modular Group — 2-Right */}
    <nav
      class="hidden lg:flex w-full items-center justify-center gap-6 xl:gap-10"
      aria-label={t.nav.companies}
    >
      {/* 2 Brands Left (Shower Walls, Modul Woods) */}
      <div class="flex items-center gap-4 xl:gap-8">
        {
          left.map((brand) => {
            const active = isActive(`/${brand.slug}`);
            return (
              <a
                href={href(`/${brand.slug}`)}
                aria-current={active ? "page" : undefined}
                class="press group relative flex items-center rounded-lg px-3 py-2 text-sm font-semibold tracking-tight transition-all duration-200"
                style={active ? { color: brand.swatch } : undefined}
              >
                <span class:list={[!active && "text-muted group-hover:text-ink transition-colors"]}>
                  {brand.name}
                </span>
                {/* Active / hover underline */}
                <span
                  class:list={[
                    "absolute bottom-0 left-2 right-2 h-[2.5px] rounded-full transition-all duration-300",
                    active
                      ? "opacity-100 scale-x-100"
                      : "opacity-0 scale-x-0 group-hover:opacity-40 group-hover:scale-x-100",
                  ]}
                  style={{ backgroundColor: brand.swatch }}
                  aria-hidden="true"
                />
              </a>
            );
          })
        }
      </div>

      {/* Center Modular Group Logo */}
      <a
        href={href("/")}
        aria-label={t.nav.groupHome}
        aria-current={isActive("/") ? "page" : undefined}
        class="press relative mx-4 flex flex-col items-center rounded-xl px-4 py-2 transition-all hover:bg-panelAlt/60"
      >
        <GroupMark size="lg" />
        {
          isActive("/") && (
            <span
              class="absolute bottom-0 left-4 right-4 h-[2px] rounded-full bg-ink opacity-80"
              aria-hidden="true"
            />
          )
        }
      </a>

      {/* 2 Brands Right (Küartz Surfaces, Modular Vanity Tops) */}
      <div class="flex items-center gap-4 xl:gap-8">
        {
          right.map((brand) => {
            const active = isActive(`/${brand.slug}`);
            return (
              <a
                href={href(`/${brand.slug}`)}
                aria-current={active ? "page" : undefined}
                class="press group relative flex items-center rounded-lg px-3 py-2 text-sm font-semibold tracking-tight transition-all duration-200"
                style={active ? { color: brand.swatch } : undefined}
              >
                <span class:list={[!active && "text-muted group-hover:text-ink transition-colors"]}>
                  {brand.name}
                </span>
                {/* Active / hover underline */}
                <span
                  class:list={[
                    "absolute bottom-0 left-2 right-2 h-[2.5px] rounded-full transition-all duration-300",
                    active
                      ? "opacity-100 scale-x-100"
                      : "opacity-0 scale-x-0 group-hover:opacity-40 group-hover:scale-x-100",
                  ]}
                  style={{ backgroundColor: brand.swatch }}
                  aria-hidden="true"
                />
              </a>
            );
          })
        }
      </div>
    </nav>

    {/* Discreet Right Utility Controls (Lang + Theme) — docked cleanly */}
    <div class="flex items-center gap-1.5 lg:absolute lg:right-6 xl:lg:right-10">
      <div class="hidden sm:block">
        <LangToggle label={t.nav.language} />
      </div>
      <ThemeToggle label={t.nav.theme} />
    </div>
  </div>

  {/* Mobile Sheet */}
  <div
    id="mobile-nav"
    data-mobile-nav
    hidden
    class="origin-top border-t border-line bg-canvas/95 backdrop-blur-xl lg:hidden"
  >
    <div class="container-x py-6">
      <ul class="grid gap-1.5">
        <li>
          <a
            href={href("/")}
            aria-current={isActive("/") ? "page" : undefined}
            class="press flex items-center justify-between rounded-2xl px-4 py-3.5 font-semibold text-ink hover:bg-panelAlt aria-[current=page]:bg-panelAlt"
          >
            {t.nav.home}
          </a>
        </li>

        {
          BRANDS.map((brand) => {
            const active = isActive(`/${brand.slug}`);
            return (
              <li>
                <a
                  href={href(`/${brand.slug}`)}
                  aria-current={active ? "page" : undefined}
                  class="press flex items-center justify-between rounded-2xl px-4 py-3.5 text-base font-semibold transition-colors hover:bg-panelAlt aria-[current=page]:bg-panelAlt"
                  style={active ? { color: brand.swatch } : undefined}
                >
                  <span>{brand.name}</span>
                  {active && (
                    <span
                      class="h-1.5 w-1.5 rounded-full"
                      style={{ backgroundColor: brand.swatch }}
                    />
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="mt-6 flex items-center justify-center gap-3 border-t border-line pt-5">
        <LangToggle label={t.nav.language} />
      </div>
    </div>
  </div>
</header>

<script>
  let cleanup: (() => void) | null = null;

  function initHeader() {
    cleanup?.();

    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-mobile-nav]");

    const setOpen = (open: boolean) => {
      if (!toggle || !panel) return;
      toggle.setAttribute("aria-expanded", String(open));

      if (open) {
        panel.hidden = false;
        requestAnimationFrame(() => {
          panel.style.opacity = "1";
          panel.style.transform = "none";
        });
      } else {
        panel.style.opacity = "0";
        panel.style.transform = "translateY(-8px) scale(0.99)";
        window.setTimeout(() => {
          if (toggle.getAttribute("aria-expanded") === "false") panel.hidden = true;
        }, 220);
      }

      document.documentElement.classList.toggle("overflow-hidden", open);
      toggle.setAttribute(
        "aria-label",
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ??
          toggle.getAttribute("aria-label") ??
          "",
      );
      toggle.querySelector("[data-menu-icon]")?.classList.toggle("hidden", open);
      toggle.querySelector("[data-close-icon]")?.classList.toggle("hidden", !open);
    };

    if (panel) {
      panel.style.transition =
        "opacity 240ms cubic-bezier(0.22,1,0.36,1), transform 240ms cubic-bezier(0.22,1,0.36,1)";
      panel.style.opacity = "0";
      panel.style.transform = "translateY(-8px) scale(0.99)";
    }

    const onToggleClick = () =>
      setOpen(toggle?.getAttribute("aria-expanded") !== "true");
    toggle?.addEventListener("click", onToggleClick);

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    };
    document.addEventListener("keydown", onKeydown);

    const onNavigate = () => {
      document.documentElement.classList.remove("overflow-hidden");
      setOpen(false);
    };
    panel?.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) onNavigate();
    });

    cleanup = () => {
      document.removeEventListener("keydown", onKeydown);
      toggle?.removeEventListener("click", onToggleClick);
      document.documentElement.classList.remove("overflow-hidden");
    };
  }

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
